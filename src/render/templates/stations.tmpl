{{define "body"}}
{{if .Empty}}
<section class="section"><p class="empty">暂无空间站数据。</p></section>
{{else}}{{range .Items}}
<article class="dss-hud">
  <header class="dss-top"><h2>{{.Name}}</h2><span>DSS</span></header>
  <div class="dss-div"></div>
  <div class="dss-grid">
    <section><h3 class="dss-sec">战术行动</h3>
      {{range .Actions}}<div class="dss-action">
        {{if .Icon}}{{icon .Icon "dss-icon"}}{{else}}<span></span>{{end}}
        <strong>{{.Name}}</strong><span class="tag {{.StatusClass}}">{{.Status}}</span>
      </div>{{else}}<p class="empty">当前没有战术行动。</p>{{end}}
    </section>
    <section class="dss-summary">
      <div class="dss-hero">{{icon "emblem.dss" "dss-station"}}</div>
      <div class="dss-detail"><h3>选举 / 跃迁截止</h3><strong class="mono">{{.ElectionEnd}}</strong></div>
    </section>
  </div>
</article>
{{end}}{{end}}
{{end}}
