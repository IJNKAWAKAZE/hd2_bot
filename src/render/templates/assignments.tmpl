{{- /* assignments 是 /assignments 的重要指令卡片：上游当前没有进行中的指令时出占位卡（不是错误）。
       视图模型是 Go 侧的 orders.AssignmentsCard，字段都已格式化，模板只排版、不做计算。
       任务区来自 orders.AssignmentTaskItem：一行「任务名 + 当前/目标（百分比）」，
       只有「有当前值也有目标值」时才补一条进度条（.bar/.bar__fill 是 base.tmpl 的通用 class）。
       通用 class 见 base.tmpl（.section/.row/.muted/.empty/.bar 等）。 */ -}}
{{define "body"}}
{{if .Empty}}
<section class="section">
  <p class="empty">暂无重要指令。</p>
</section>
{{else}}
<section class="section">
  <h2 class="section__title">进行中</h2>
  <div class="row"><span class="muted">重要指令条数</span><span class="strong mono">{{.Count}}</span></div>
</section>

{{range .Items}}
<section class="section">
  <h2 class="section__title">{{.Title}}</h2>
  <p class="text">{{.Briefing}}</p>
  {{range .Tasks}}
  <div class="row"><span class="strong">{{.Title}}</span><span class="mono">{{.Numbers}}</span></div>
  {{if .Bar}}<div class="bar"><div class="bar__fill" style="width: {{.Percent}}%"></div></div>{{end}}
  {{end}}
  <div class="row"><span class="muted">奖励</span><span class="strong">{{.Reward}}</span></div>
  <div class="row"><span class="muted">截止时间</span><span class="mono">{{.Expiration}}</span></div>
</section>
{{end}}
{{end}}
{{end}}
