{{- /* help 是 /help 的指令一览卡片：命令清单来自 system 包里的唯一一份表，模板只排版。
       帮助是静态内容：没有数据时间，也没有过期角标（Meta.DataTime 为空时外壳会自动隐藏这一行）。 */ -}}
{{define "body"}}
<section class="section">
  <h2 class="section__title">全部指令</h2>
  <ul class="list">
    {{range .Commands}}
    <li class="list__item">
      <span class="grow">
        <span class="strong mono">/{{.Name}}</span>
        <span class="muted">{{.Desc}}</span>
      </span>
      <span class="muted mono">{{.Example}}</span>
    </li>
    {{end}}
  </ul>
</section>


{{end}}